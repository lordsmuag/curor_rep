# Copy to .env and fill in values. Never commit real secrets.

# Report currency for the summed total
REPORT_CURRENCY=CNY

# FX rates used to convert non-CNY balances into REPORT_CURRENCY
# Format: PAIR=rate,PAIR=rate
FX_RATES=HKD/CNY=0.92,USD/CNY=7.20

# Set DEMO=true to print sample numbers without connecting to brokers
DEMO=false

# --- Futu OpenAPI (requires OpenD running) ---
FUTU_ENABLED=true
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
# REAL or SIMULATE
FUTU_TRD_ENV=REAL
# NONE / HK / US / CN / SG / JP / AU
FUTU_FILTER_TRDMARKET=NONE
FUTU_SECURITY_FIRM=FUTUSECURITIES
FUTU_CURRENCY=HKD
# Optional: unlock trade PIN (only if OpenD requires it for fund queries)
# FUTU_TRADE_PASSWORD=******
# Optional shortcut if you only need HKD->CNY
# FUTU_TO_CNY_RATE=0.92

# --- Tonghuashun (no official remote API) ---
THS_ENABLED=true
# file | http | env
THS_MODE=file
THS_SNAPSHOT_PATH=data/ths_snapshot.json
# If THS_MODE=http, point at your local bridge (e.g. THSAutoTrader)
THS_HTTP_URL=http://127.0.0.1:5000/balance
# If THS_MODE=env, set the number directly:
# THS_TOTAL_ASSETS=200000.00
THS_CURRENCY=CNY
